<?xml version="1.0" encoding="utf-8"?>
<!-- Placeholder pixel button. Pressed/selected states use the highlight color. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/book_gold" />
            <stroke android:width="3dp" android:color="@color/book_ink" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/book_highlight" />
            <stroke android:width="3dp" android:color="@color/book_ink" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/book_paper" />
            <stroke android:width="3dp" android:color="@color/book_ink" />
        </shape>
    </item>
</selector>

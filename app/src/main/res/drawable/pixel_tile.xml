<?xml version="1.0" encoding="utf-8"?>
<!-- Square ingredient tile. "selected" = needed for the current step (gold border). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/book_highlight" />
            <stroke android:width="5dp" android:color="@color/book_gold" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/book_paper" />
            <stroke android:width="3dp" android:color="@color/book_ink" />
        </shape>
    </item>
</selector>

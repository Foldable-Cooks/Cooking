<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#EDE4D1"
    android:padding="24dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="12dp"
        android:background="@drawable/main_cover"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:elevation="8dp" >

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" * * *"
        android:textColor="#E6CC9C"
        android:textSize="24sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RECIPE BOOK"
            android:textColor="#F4E8CD"
            android:textSize="34sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:layout_marginTop="30dp"
            android:id="@+id/title" />

        <Button
            android:id="@+id/playButton"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:text="START COOKING!"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#354B38"
            android:backgroundTint="#E8D3A5"
            android:elevation="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open your phone to choose your recipe..."
            android:textColor="#F4E8CD"
            android:fontFamily="serif"
            android:textSize="18sp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginTop="24dp"
            android:id="@+id/waitingMsg"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open the book to start cooking!"
            android:textColor="#F4E8CD"
            android:textSize="13sp"
            android:fontFamily="serif"
            android:layout_marginTop="30dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="*"
            android:textColor="#E6CC9C"
            android:textSize="24sp"
            android:layout_marginTop="20dp" />

    </LinearLayout>


</LinearLayout>
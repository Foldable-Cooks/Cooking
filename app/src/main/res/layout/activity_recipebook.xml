<?xml version="1.0" encoding="utf-8"?>
<!--
    Recipe book. Folded: the cover. Open: index on the left page, recipe on the
    right page, with the spine on the phone's hinge (see BookSpreadView).
-->
<com.example.cookinggame.BookSpreadView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/book"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/book_cover_dark">

    <include
        android:id="@id/bookCover"
        layout="@layout/cover_recipebook"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include
        android:id="@id/bookLeftPage"
        layout="@layout/page_recipe_index"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@id/bookSpine"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/book_gold" />

    <include
        android:id="@id/bookRightPage"
        layout="@layout/page_recipe_detail"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</com.example.cookinggame.BookSpreadView>

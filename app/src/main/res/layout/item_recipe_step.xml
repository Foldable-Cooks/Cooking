<?xml version="1.0" encoding="utf-8"?>
<!-- One numbered step: "1.  [FOLD]  Fold your phone to ..." -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/stepNumber"
        style="@style/PixelText"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/stepAction"
        style="@style/PixelText.Small"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:background="@drawable/pixel_tag"
        android:gravity="center"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textColor="@color/book_paper"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/stepText"
        style="@style/PixelText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Right page of the recipe book: the selected recipe's picture, ingredients and steps. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/pixel_page"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/prevPageButton"
            style="@style/PixelButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/previous_recipe"
            android:text="&lt;" />

        <TextView
            android:id="@+id/recipeTitle"
            style="@style/PixelText.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center" />

        <TextView
            android:id="@+id/nextPageButton"
            style="@style/PixelButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/next_recipe"
            android:text="&gt;" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/recipeScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/recipeImage"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal"
                android:scaleType="fitCenter"
                android:contentDescription="@string/recipe_picture" />

            <TextView
                style="@style/PixelText.Header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ingredients_header" />

            <TextView
                android:id="@+id/recipeIngredients"
                style="@style/PixelText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp" />

            <TextView
                style="@style/PixelText.Header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/steps_header" />

            <!-- Filled with item_recipe_step rows in RecipeBook.java -->
            <LinearLayout
                android:id="@+id/recipeSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/pageNumber"
        style="@style/PixelText.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/startCookingButton"
        style="@style/PixelButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:textSize="18sp"
        android:text="@string/start_cooking" />
</LinearLayout>

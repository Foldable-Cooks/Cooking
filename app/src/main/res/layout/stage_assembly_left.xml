<?xml version="1.0" encoding="utf-8"?>
<!-- ASSEMBLY, left page: current step + ingredient tray (drag sources). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/stage_step_header" />

    <TextView
        style="@style/PixelText.Header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ingredients_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Filled with item_ingredient_tile by AssemblyStage -->
        <GridLayout
            android:id="@+id/ingredientTray"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2" />
    </ScrollView>
</LinearLayout>

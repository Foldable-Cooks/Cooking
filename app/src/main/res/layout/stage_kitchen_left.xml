<?xml version="1.0" encoding="utf-8"?>
<!-- Left side of the kitchen table (Assembly + Cooking): ingredients to drag. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        style="@style/PixelText.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:textColor="@color/book_paper"
        android:textStyle="bold"
        android:text="@string/kitchen_ingredients" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Filled with item_ingredient_tile by KitchenStage -->
        <GridLayout
            android:id="@+id/ingredientTray"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3" />
    </ScrollView>
</LinearLayout>

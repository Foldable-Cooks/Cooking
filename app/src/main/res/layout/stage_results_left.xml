<?xml version="1.0" encoding="utf-8"?>
<!-- RESULTS, left side of the table: the finished dish on a plate. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center">

    <com.example.cookinggame.SquareFrameLayout
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:background="@drawable/station_plate"
        android:padding="40dp">

        <ImageView
            android:id="@+id/resultDishImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="@string/recipe_picture" />
    </com.example.cookinggame.SquareFrameLayout>

    <TextView
        android:id="@+id/resultDishName"
        style="@style/PixelText.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="@color/book_paper" />

    <TextView
        style="@style/PixelText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/book_highlight"
        android:text="@string/results_enjoy" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Shared top of the Assembly / Cooking left page: stage name, progress and the current step. Filled by Gameplay. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/recipeName"
        style="@style/PixelText.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center" />

    <TextView
        android:id="@+id/stageTitle"
        style="@style/PixelText.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center" />

    <TextView
        android:id="@+id/stepCounter"
        style="@style/PixelText.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/stepAction"
            style="@style/PixelText.Small"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/pixel_tag"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="@color/book_paper"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stepInstruction"
            style="@style/PixelText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="17sp" />
    </LinearLayout>
</LinearLayout>
